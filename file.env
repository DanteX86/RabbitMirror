x# RabbitMirror Production Environment Configuration
# Generated on: 2025-07-27
#
# SECURITY WARNING: Keep this file secure and never commit it to version control!
# Add .env to your .gitignore file if not already present.

# Flask Application Settings
SECRET_KEY=DGvW33NYeGyJy0pXpeqfQcCXyg8HmP41uEfLYFsE0F4
FLASK_ENV=production
FLASK_DEBUG=False

# Database Configuration
# SQLite for development/testing (default)
DATABASE_URL=sqlite:///rabbitmirror.db

# For PostgreSQL production deployment, use:
# DATABASE_URL=postgresql://username:password@localhost:5432/rabbitmirror

# For MySQL production deployment, use:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/rabbitmirror

# Redis Configuration (Optional - for enhanced caching and session storage)
# Uncomment and configure if you have Redis available
# REDIS_URL=redis://localhost:6379/0

# Security Settings
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
MAX_FILE_SIZE=104857600

# Session Configuration
SESSION_LIFETIME=86400
CLEANUP_INTERVAL=3600

# Database Connection Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Application Settings
MAX_CONTENT_LENGTH=104857600
UPLOAD_FOLDER=uploads

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/rabbitmirror.log

# Cache Settings
CACHE_TTL=3600

# Additional Security Headers
SECURITY_HEADERS_ENABLED=true

# ReadMe (rdme) CLI Settings
# Provide your ReadMe API credentials here. Keep this file private.
# These are used by Makefile targets like `make rdme-openapi`.
README_API_KEY=
README_DEFINITION_ID=
# Default path to your OpenAPI spec (override per-command if needed)
OPENAPI_PATH=openapi.yaml

# Copy this file to .env and set your secrets.
# DO NOT commit your real secrets.

# ReadMe API key with write access to your project
README_API_KEY={{README_API_KEY}}

# ReadMe API definition ID to update (e.g., 12345)
README_DEFINITION_ID={{README_DEFINITION_ID}}

# Path to your OpenAPI file (override in make if needed)
OPENAPI_PATH=openapi.yaml
